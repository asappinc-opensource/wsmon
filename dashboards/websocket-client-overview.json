{
  "uid": "wsmon-overview",
  "title": "WebSocket synthetic monitoring — Overview",
  "description": "Health of every wsmon target, per entry point. Idle probes are excluded.",
  "tags": [
    "websocket",
    "synthetic",
    "wsmon",
    "edge",
    "overview"
  ],
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Detail dashboard",
      "type": "link",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "url": "/d/wsmon-probe/?${datasource:queryparam}"
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet — all targets",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets reporting",
      "description": "Targets with at least one probe reporting now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (target) (wsmon_client_connection_up))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3d71d9",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Vantages reporting",
      "description": "Vantages with at least one probe reporting now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (vantage) (wsmon_client_connection_up))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3d71d9",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active probes (pingpong + burst)",
      "description": "Pingpong and burst probes that are up, down, or missing (reported in the last hour but not now).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (target, vantage, entrypoint, mode) (wsmon_client_connection_up{mode!=\"idle\"}) == 1) or vector(0)",
          "legendFormat": "Up",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (target, vantage, entrypoint, mode) (wsmon_client_connection_up{mode!=\"idle\"}) == 0) or vector(0)",
          "legendFormat": "Down",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (target, vantage, entrypoint, mode) (max_over_time(wsmon_client_connection_up{mode!=\"idle\"}[1h]))\nunless max by (target, vantage, entrypoint, mode) (wsmon_client_connection_up{mode!=\"idle\"})) or vector(0)",
          "legendFormat": "Missing",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#0ca30c",
                      "value": null
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#0ca30c",
                      "value": null
                    },
                    {
                      "color": "#fab219",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Delivery — last 5m",
      "description": "Share of sent messages that were echoed back, across all targets.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(wsmon_client_messages_echoed_total{mode!=\"idle\"}[5m]))\n/ (sum(increase(wsmon_client_messages_sent_total{mode!=\"idle\"}[5m])) > 0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0.99
              },
              {
                "color": "#0ca30c",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Abnormal closes (1006) — last 1h",
      "description": "Connections dropped without a close frame, across all targets.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum(increase(wsmon_client_closes_total{mode!=\"idle\", close_code=\"1006\"}[1h]))) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Lost messages — last 1h",
      "description": "Messages with no echo before the deadline, across all targets.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum(increase(wsmon_client_messages_lost_total{mode!=\"idle\"}[1h]))) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Target status — active probes down or missing",
      "description": "Probes down or missing, per target.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (target) (\n  (max by (target, vantage, entrypoint, mode) (wsmon_client_connection_up{mode!=\"idle\"}) == 0)\n  or (max by (target, vantage, entrypoint, mode) (max_over_time(wsmon_client_connection_up{mode!=\"idle\"}[1h]))\n      unless max by (target, vantage, entrypoint, mode) (wsmon_client_connection_up{mode!=\"idle\"}))\n)\nor 0 * count by (target) (max by (target, vantage, entrypoint, mode) (max_over_time(wsmon_client_connection_up{mode!=\"idle\"}[1h])))",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "#0ca30c",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO DATA",
                  "color": "#898781",
                  "index": 1
                }
              }
            }
          ],
          "decimals": 0,
          "unit": "suffix: down",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Open ${__field.labels.target} in the detail dashboard",
              "targetBlank": false,
              "url": "/d/wsmon-probe/?var-target=${__field.labels.target}&${datasource:queryparam}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "timeFrom": "1h",
      "hideTimeOverride": true,
      "maxDataPoints": 60
    },
    {
      "id": 10,
      "type": "row",
      "title": "By target and entry point",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Status now — active probes down or missing, per entry point",
      "description": "Probes down or missing, per target and entry point. All entry points of a target failing points to the server; only some points to their layer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (target, entrypoint) (\n  (max by (target, vantage, entrypoint, mode) (wsmon_client_connection_up{mode!=\"idle\"}) == 0)\n  or (max by (target, vantage, entrypoint, mode) (max_over_time(wsmon_client_connection_up{mode!=\"idle\"}[1h]))\n      unless max by (target, vantage, entrypoint, mode) (wsmon_client_connection_up{mode!=\"idle\"}))\n)\nor 0 * count by (target, entrypoint) (max by (target, vantage, entrypoint, mode) (max_over_time(wsmon_client_connection_up{mode!=\"idle\"}[1h])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "entrypoint"
              }
            ]
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "entrypoint",
            "rowField": "target",
            "valueField": "Value",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "target\\entrypoint": "Target"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "#0ca30c",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "—",
                  "color": "transparent",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "empty",
                "result": {
                  "text": "—",
                  "color": "transparent",
                  "index": 2
                }
              }
            }
          ],
          "decimals": 0,
          "unit": "suffix: down",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Open ${__data.fields[0]} · ${__field.name} in the detail dashboard",
              "targetBlank": false,
              "url": "/d/wsmon-probe/?var-target=${__data.fields[0]}&var-entrypoint=${__field.name}&${datasource:queryparam}&${__url_time_range}"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "string"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__data.fields[0]} in the detail dashboard",
                    "targetBlank": false,
                    "url": "/d/wsmon-probe/?var-target=${__data.fields[0]}&${datasource:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [
          {
            "displayName": "Target",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Every target and entry point — over the dashboard range (pingpong + burst)",
      "description": "Availability, delivery, p99 RTT, abnormal closes, lost messages and connect failures per target and entry point over the range. RTT turns amber at 250 ms and red at 1 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (target, entrypoint) (\n  (max by (target, vantage, entrypoint, mode) (wsmon_client_connection_up{mode!=\"idle\"}) == 0)\n  or (max by (target, vantage, entrypoint, mode) (max_over_time(wsmon_client_connection_up{mode!=\"idle\"}[1h]))\n      unless max by (target, vantage, entrypoint, mode) (wsmon_client_connection_up{mode!=\"idle\"}))\n)\nor 0 * count by (target, entrypoint) (max by (target, vantage, entrypoint, mode) (max_over_time(wsmon_client_connection_up{mode!=\"idle\"}[1h])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (target, entrypoint) (count by (target, entrypoint, vantage) (wsmon_client_connection_up{mode!=\"idle\"}))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg by (target, entrypoint) (avg_over_time(wsmon_client_connection_up{mode!=\"idle\"}[$__range]))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (target, entrypoint) (increase(wsmon_client_messages_echoed_total{mode!=\"idle\"}[$__range]))\n/ (sum by (target, entrypoint) (increase(wsmon_client_messages_sent_total{mode!=\"idle\"}[$__range])) > 0)",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, target, entrypoint) (rate(wsmon_client_rtt_seconds_bucket{mode!=\"idle\", payload=\"small\"}[$__range])))",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
